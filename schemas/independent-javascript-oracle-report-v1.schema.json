{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eilodon.github.io/hsdl-harmonization-gap/schemas/independent-javascript-oracle-report-v1.schema.json",
  "title": "Independent JavaScript candidate oracle report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "implementation", "runtime", "claim_class",
    "legal_validation", "profile_id", "rule_count", "context_count",
    "assumption_set_count", "projection_count", "expected_projection_hash",
    "actual_projection_hash", "projection_hash_match", "state_counts",
    "projections_by_assumption_set", "implementation_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "EQUIVALENT"},
    "implementation": {"const": "INDEPENDENT_JAVASCRIPT_ORACLE_V1"},
    "runtime": {"type": "string", "pattern": "^node-"},
    "claim_class": {"const": "MODEL_RELATIVE"},
    "legal_validation": {"const": "NOT_ASSERTED"},
    "profile_id": {"const": "current-candidate-2026-08-02"},
    "rule_count": {"const": 20},
    "context_count": {"const": 322},
    "assumption_set_count": {"const": 2},
    "projection_count": {"const": 12880},
    "expected_projection_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actual_projection_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_hash_match": {"const": true},
    "state_counts": {"type": "object"},
    "projections_by_assumption_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NO_ASSUMPTIONS", "ASSUME_ARTICLE13_TIMING_TRIGGER_SATISFIED"],
      "properties": {
        "NO_ASSUMPTIONS": {"const": 6440},
        "ASSUME_ARTICLE13_TIMING_TRIGGER_SATISFIED": {"const": 6440}
      }
    },
    "implementation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_python_evaluator_code", "shared_hsdl_document", "shared_context_corpus",
        "shared_assumption_fixture", "upstream_hsdl_compatibility", "notice"
      ],
      "properties": {
        "shared_python_evaluator_code": {"const": false},
        "shared_hsdl_document": {"const": true},
        "shared_context_corpus": {"const": true},
        "shared_assumption_fixture": {"const": true},
        "upstream_hsdl_compatibility": {"const": "NOT_CLAIMED"},
        "notice": {"type": "string", "minLength": 1}
      }
    }
  }
}
