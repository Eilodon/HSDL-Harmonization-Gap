{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eilodon.github.io/hsdl-harmonization-gap/schemas/candidate-hsdl-differential-report-v1.schema.json",
  "title": "Candidate HSDL Core 0.2 differential report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "claim_class", "legal_validation", "profile_id",
    "hsdl_profile", "document_hash", "document_line_count", "document_byte_count",
    "rule_count", "duty_count", "context_count", "assumption_set_count",
    "comparison_count", "comparisons_by_assumption_set", "structural_round_trip_equal",
    "mismatch_count", "mismatch_samples", "compatibility_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "EQUIVALENT"},
    "claim_class": {"const": "MODEL_RELATIVE"},
    "legal_validation": {"const": "NOT_ASSERTED"},
    "profile_id": {"const": "current-candidate-2026-08-02"},
    "hsdl_profile": {"const": "HSDL_CORE_0_2_REPOSITORY_DEFINED"},
    "document_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "document_line_count": {"type": "integer", "minimum": 1},
    "document_byte_count": {"type": "integer", "minimum": 1},
    "rule_count": {"const": 20},
    "duty_count": {"const": 25},
    "context_count": {"const": 322},
    "assumption_set_count": {"const": 2},
    "comparison_count": {"const": 12880},
    "comparisons_by_assumption_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NO_ASSUMPTIONS", "ASSUME_ARTICLE13_TIMING_TRIGGER_SATISFIED"],
      "properties": {
        "NO_ASSUMPTIONS": {"const": 6440},
        "ASSUME_ARTICLE13_TIMING_TRIGGER_SATISFIED": {"const": 6440}
      }
    },
    "structural_round_trip_equal": {"const": true},
    "mismatch_count": {"const": 0},
    "mismatch_samples": {"type": "array", "maxItems": 0},
    "compatibility_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_hsdl_compatibility", "independent_implementation",
        "current_law_validation", "notice"
      ],
      "properties": {
        "upstream_hsdl_compatibility": {"const": "NOT_CLAIMED"},
        "independent_implementation": {"const": false},
        "current_law_validation": {"const": "NOT_ASSERTED"},
        "notice": {"type": "string", "minLength": 1}
      }
    }
  }
}
