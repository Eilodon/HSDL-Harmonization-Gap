{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eilodon.github.io/hsdl-harmonization-gap/schemas/operational-duty-signature-report-v1.schema.json",
  "title": "Operational duty signature report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "claim_class", "legal_validation",
    "candidate_profile_id", "signature_definition", "duty_count",
    "duties_by_jurisdiction", "cross_jurisdiction_pair_count",
    "cross_jurisdiction_relation_counts", "same_slot_cross_jurisdiction_pair_count",
    "exact_cross_jurisdiction_pair_count", "actor_variant_cross_jurisdiction_pair_count",
    "duplicate_signature_hashes", "duplicate_normative_slots", "inventory",
    "same_slot_comparisons", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "OPERATIONAL_DUTY_SIGNATURE_INVENTORY_COMPLETE"},
    "claim_class": {"const": "MODEL_RELATIVE"},
    "legal_validation": {"const": "NOT_ASSERTED"},
    "candidate_profile_id": {"const": "current-candidate-2026-08-02"},
    "signature_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "exact_requires_all_fields_equal", "action_and_obligor_order"],
      "properties": {
        "fields": {
          "const": [
            "normative_slot", "actions", "object", "obligors", "actor_relation", "timing"
          ]
        },
        "exact_requires_all_fields_equal": {"const": true},
        "action_and_obligor_order": {"const": "CANONICAL_SORTED_SET"}
      }
    },
    "duty_count": {"const": 25},
    "duties_by_jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EU", "VN"],
      "properties": {
        "EU": {"const": 8},
        "VN": {"const": 17}
      }
    },
    "cross_jurisdiction_pair_count": {"const": 136},
    "cross_jurisdiction_relation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["INCOMPARABLE_DIFFERENT_SLOT"],
      "properties": {
        "INCOMPARABLE_DIFFERENT_SLOT": {"const": 136}
      }
    },
    "same_slot_cross_jurisdiction_pair_count": {"const": 0},
    "exact_cross_jurisdiction_pair_count": {"const": 0},
    "actor_variant_cross_jurisdiction_pair_count": {"const": 0},
    "duplicate_signature_hashes": {"type": "object"},
    "duplicate_normative_slots": {"type": "object"},
    "inventory": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["jurisdiction", "rule_id", "duty_id", "signature", "signature_hash"],
        "properties": {
          "jurisdiction": {"enum": ["EU", "VN"]},
          "rule_id": {"type": "string", "minLength": 1},
          "duty_id": {"type": "string", "minLength": 1},
          "signature": {"$ref": "#/$defs/signature"},
          "signature_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "same_slot_comparisons": {"type": "array", "maxItems": 0},
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_field_available", "modality_field_available",
        "trigger_semantics_in_signature", "crosswalk_review", "notice"
      ],
      "properties": {
        "recipient_field_available": {"const": false},
        "modality_field_available": {"const": false},
        "trigger_semantics_in_signature": {"const": false},
        "crosswalk_review": {"const": "NOT_PERFORMED_BY_SIGNATURE_EQUALITY"},
        "notice": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normative_slot", "actions", "object", "obligors", "actor_relation", "timing"],
      "properties": {
        "normative_slot": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "object": {"type": "string", "minLength": 1},
        "obligors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "actor_relation": {"type": "string", "minLength": 1},
        "timing": {"type": "string", "minLength": 1}
      }
    }
  }
}
